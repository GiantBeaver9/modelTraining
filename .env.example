# Copy to `.env` (local) or paste into Railway → Variables. NEVER commit real keys (.env is gitignored).
# The app serves BOTH behaviors; each behavior points at YOUR fine-tuned HF model.

# ── Login (hide the demo) ──────────────────────────────────────────────
BASIC_AUTH_USER=changeme
BASIC_AUTH_PASS=use-a-strong-password

# ── Point each behavior at YOUR fine-tuned HF model ────────────────────
HF_PREFIX=your-hf-username
SECRET_AGENT=qwen-gatekeeper        # -> your-hf-username/qwen-gatekeeper  (No-Leak Gatekeeper)
SOVEREIGN_AGENT=qwen-sovereign      # -> your-hf-username/qwen-sovereign   (Sovereign Engineer)
HF_TOKEN=hf_xxx                     # read token (needed if the model repos are private)
HF_BASE_URL=https://router.huggingface.co/v1   # default OpenAI-compatible HF endpoint

# If a model is deployed as a dedicated HF Inference Endpoint (its own URL), override per agent:
# SECRET_AGENT_BASE_URL=https://<name>.endpoints.huggingface.cloud/v1
# SOVEREIGN_AGENT_BASE_URL=https://<name>.endpoints.huggingface.cloud/v1
# (You can also point these at a local vLLM/Ollama OpenAI endpoint.)

# ── Fallback model when an agent isn't set (keeps the demo working) ────
GUARD_PROVIDER=gemini
GUARD_MODEL=gemini-flash-latest
GEMINI_API_KEY=your-gemini-key

# ── Gemini as the LLM judge (spends your Gemini credit) ────────────────
JUDGE_ENABLED=1
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-flash-latest
JUDGE_API_KEY_ENV=GEMINI_API_KEY

# ── Gatekeeper secret + generation ────────────────────────────────────
SECRET_PASSPHRASE=MIDNIGHT-SWORDFISH-7731
TEMPERATURE=0.3
MAX_TOKENS=512

# ── Run base-vs-tuned eval on startup so /results is ready to view ─────
# Only works for models the host can reach over HTTP (needs the models served via HF_BASE_URL).
# Unreachable models -> scenarios marked ERROR (not fake passes). For guaranteed numbers, run
# run_all_evals.sh on a GPU and commit results/reports/*.json instead.
RUN_EVAL_ON_START=0                 # set to 1 to enable
EVAL_LIMIT=40                       # scenarios per run (keep modest)
EVAL_SLEEP=2                        # seconds between scenarios (paced/slow)
EVAL_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
