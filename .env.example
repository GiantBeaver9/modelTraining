# ─────────────────────────────────────────────────────────────────────────────
# Railway → Variables (or copy to .env locally; .env is gitignored — never commit keys)
#
# The tuned models + their dedicated HF endpoints are now BAKED INTO THE CODE as
# defaults, so the demo works with almost nothing set. You only really need the
# HF token + a login. Everything below "ADVANCED" is optional overrides.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────
# HF read token — used to call the two dedicated Inference Endpoints (both models).
HF_TOKEN=hf_xxx

# Login for the demo (set both, or the app runs public with a warning banner).
BASIC_AUTH_USER=changeme
BASIC_AUTH_PASS=use-a-strong-password

# ── RECOMMENDED ──────────────────────────────────────────────────────────────
# The secret the Gatekeeper must protect (any string; a default exists if unset).
SECRET_PASSPHRASE=MIDNIGHT-SWORDFISH-7731

# Verdicts: how each reply is judged "held" vs "broke".
#   JUDGE_ENABLED=0  -> rule-based detector only. No external key, nothing to break. (Simplest.)
#   JUDGE_ENABLED=1  -> detector PLUS an LLM judge for subtle cases (needs a valid key below).
# Either way, if the LLM judge is down the app now falls back to the detector and never errors.
JUDGE_ENABLED=0

# ── OPTIONAL: turn the LLM judge on (only if JUDGE_ENABLED=1) ─────────────────
# Gemini (get a key at https://aistudio.google.com/apikey):
# JUDGE_PROVIDER=gemini
# JUDGE_MODEL=gemini-flash-latest
# JUDGE_API_KEY_ENV=GEMINI_API_KEY
# GEMINI_API_KEY=your-valid-gemini-key
#
# ...or OpenRouter instead of Gemini:
# JUDGE_PROVIDER=openai_compatible
# JUDGE_MODEL=anthropic/claude-sonnet-4.5
# JUDGE_API_KEY_ENV=OPENROUTER_API_KEY
# JUDGE_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=your-openrouter-key

# ── ADVANCED: override the baked-in model routing (usually leave unset) ───────
# Defaults already point each behavior at its model + dedicated /v1 endpoint:
#   gatekeeper -> anash91/qwen-gatekeeper @ m7878y0gr5t411mu...endpoints.huggingface.cloud/v1
#   sovereign  -> anash91/qwen-sovereign  @ nvghh0cpaez7rhsx...endpoints.huggingface.cloud/v1
# Only set these if you RECREATE an endpoint (new subdomain) or push under a new repo.
# A missing /v1 is auto-appended, so either form works.
# SECRET_AGENT=anash91/qwen-gatekeeper
# SOVEREIGN_AGENT=anash91/qwen-sovereign
# SECRET_AGENT_BASE_URL=https://<gatekeeper-endpoint>.endpoints.huggingface.cloud/v1
# SOVEREIGN_AGENT_BASE_URL=https://<sovereign-endpoint>.endpoints.huggingface.cloud/v1

# ── ADVANCED: misc ───────────────────────────────────────────────────────────
# TEMPERATURE=0.3
# MAX_TOKENS=512
# WARMUP_ON_START=1     # ping both endpoints on boot so the first prompt isn't a cold start
